# Copy to .env.local for local dev. Set the same values in Netlify env for production.

# Supabase (client) — public anon key is safe to expose.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push (client) — public VAPID key. Must match VAPID_PUBLIC_KEY used by the
# netlify functions, or push subscriptions will fail silently.
VITE_VAPID_PUBLIC_KEY=

# Admin reset PIN. Required to perform a hard reset from the admin panel.
# If unset, hard reset is disabled.
VITE_ADMIN_PIN=

# Server-side only (used by netlify/functions). NEVER prefix with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
